# Digital Séance - Backend Environment Configuration

# Open-weight Model Settings
# Default: Qwen/Qwen2.5-3B-Instruct
# Optional lightweight fallback for resource-constrained instances: Qwen/Qwen2.5-0.5B-Instruct or Qwen/Qwen2.5-1.5B-Instruct
MODEL_ID=Qwen/Qwen2.5-3B-Instruct
MODEL_DEVICE=auto
MODEL_DTYPE=auto
MAX_NEW_TOKENS=700
REPETITION_PENALTY=1.1
TEMPERATURE=0.7
TOP_P=0.9
MODEL_LOAD_ON_STARTUP=false

# Database Configuration (SQLite for local dev & persistent disk)
DATABASE_URL=sqlite:///./digital_seance.db

# CORS Allowed Origin
FRONTEND_URL=http://localhost:5173

# Server Port
PORT=8000

